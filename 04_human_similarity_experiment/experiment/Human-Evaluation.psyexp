  </Settings>
  <Routines>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="///////////////////////////&amp;#10;// &quot;Before Experiment&quot; TAB&amp;#10;///////////////////////////&amp;#10;&amp;#10;// Declare globals&amp;#10;var CSV_FILE           = 'csv/stimuli.csv';&amp;#10;var ORIGINAL_FOLDER    = 'images/originals_needed/';&amp;#10;var GENERATED_FOLDER   = 'images/generated/';&amp;#10;&amp;#10;var CUSTOM_BINS        = [0.000,0.300,0.400,0.457,0.514,0.571,0.629,0.686,0.743,0.800,1.000];&amp;#10;var BIN_LABELS         = CUSTOM_BINS.slice(0,-1)&amp;#10;                            .map((b,i) =&gt; b.toFixed(2) + '-' + CUSTOM_BINS[i+1].toFixed(2));&amp;#10;&amp;#10;var NUM_TRIALS         = 282;&amp;#10;var NUM_REVERSALS      = 6;&amp;#10;var MIN_TRIALS         = 60;&amp;#10;var STEPSIZE           = 1;&amp;#10;&amp;#10;// **NEW: trial‐by‐trial state**  &amp;#10;var image1_path    = &quot;&quot;;  &amp;#10;var image2_path    = &quot;&quot;;  &amp;#10;var info_str       = &quot;&quot;;  &amp;#10;var currentRow     = null;  &amp;#10;&amp;#10;// Dataframe and bin structures&amp;#10;var df                  = [];&amp;#10;var possibleValues      = [];&amp;#10;var binsToIndices       = {};&amp;#10;var imgOrderPerBin      = {};&amp;#10;var usedIdxInBin        = {};&amp;#10;var usedGlobalIndices   = new Set();&amp;#10;&amp;#10;// Staircase containers&amp;#10;var staircases, whichStairIndex;&amp;#10;// NEW: record which staircase we used each trial&amp;#10;var stairIndices = [];&amp;#10;// Logging arrays&amp;#10;var history       = [];&amp;#10;var responses     = [];&amp;#10;var reaction_times= [];&amp;#10;var key_presses   = [];&amp;#10;var orig_lefts    = [];&amp;#10;var shownRows     = [];&amp;#10;&amp;#10;// Utility: CSV parser&amp;#10;function parseCSV(text) {&amp;#10;    let lines   = text.trim().split(/\r?\n/);&amp;#10;    let headers = lines.shift().split(',');&amp;#10;    return lines.map(line =&gt; {&amp;#10;        let cols = line.split(',');&amp;#10;        let obj  = {};&amp;#10;        headers.forEach((h,i) =&gt; obj[h] = cols[i]);&amp;#10;        obj.clip_similarity = parseFloat(obj.clip_similarity);&amp;#10;        return obj;&amp;#10;    });&amp;#10;}&amp;#10;&amp;#10;// Utility: Fisher–Yates shuffle&amp;#10;function shuffle(array) {&amp;#10;    let a = array.slice();&amp;#10;    for (let i = a.length - 1; i &gt; 0; i--) {&amp;#10;        const j = Math.floor(Math.random() * (i + 1));&amp;#10;        [a[i], a[j]] = [a[j], a[i]];&amp;#10;    }&amp;#10;    return a;&amp;#10;}&amp;#10;&amp;#10;// Load &amp; preprocess CSV&amp;#10;fetch(CSV_FILE)&amp;#10;  .then(resp =&gt; resp.text())&amp;#10;  .then(text =&gt; {&amp;#10;    df = parseCSV(text).filter(r =&gt; !isNaN(r.clip_similarity));&amp;#10;&amp;#10;    // Assign each row to a bin index&amp;#10;    df.forEach((row,i) =&gt; {&amp;#10;      for (let j = 0; j &lt; CUSTOM_BINS.length - 1; j++) {&amp;#10;        let low  = CUSTOM_BINS[j],&amp;#10;            high = CUSTOM_BINS[j+1];&amp;#10;        if ((row.clip_similarity &gt;= low &amp;&amp; row.clip_similarity &lt; high) ||&amp;#10;            (j===CUSTOM_BINS.length-2 &amp;&amp; row.clip_similarity===high)) {&amp;#10;          row.bin = j;&amp;#10;          break;&amp;#10;        }&amp;#10;      }&amp;#10;    });&amp;#10;&amp;#10;    // Collect &amp; sort available bin indexes&amp;#10;    possibleValues = [...new Set(df.map(r=&gt;r.bin))];&amp;#10;    possibleValues.sort((a,b)=&gt;a-b);&amp;#10;&amp;#10;    // Build per‐bin index lists, shuffle, cap at 10&amp;#10;   /* for (let b of possibleValues) {&amp;#10;      let allIdx = df&amp;#10;        .map((r,i)=&gt; r.bin===b ? i : -1)&amp;#10;        .filter(i=&gt;i!==-1);&amp;#10;      imgOrderPerBin[b] = shuffle(allIdx).slice(0,10);  // ← cap here&amp;#10;      usedIdxInBin[b]   = 0;&amp;#10;    }*/&amp;#10;    // Build per‐bin index lists and shuffle (no cap)&amp;#10;    for (let b of possibleValues) {&amp;#10;      let allIdx = df&amp;#10;        .map((r,i)=&gt; r.bin===b ? i : -1)&amp;#10;        .filter(i=&gt;i!==-1);&amp;#10;      imgOrderPerBin[b] = shuffle(allIdx);&amp;#10;      usedIdxInBin[b]   = 0;&amp;#10;    }&amp;#10;&amp;#10;    // Create two staircases&amp;#10;    function makeStair(startHigh) {&amp;#10;      let startIdx = startHigh&amp;#10;        ? possibleValues.indexOf(Math.max(...possibleValues))&amp;#10;        : possibleValues.indexOf(Math.min(...possibleValues));&amp;#10;      return {&amp;#10;        currentIndex:    startIdx,&amp;#10;        currentBin:      possibleValues[startIdx],&amp;#10;        prevResponse:    null,&amp;#10;        reversalIndices: [],&amp;#10;        trialCount:      0,&amp;#10;        finished:        false&amp;#10;      };&amp;#10;    }&amp;#10;    staircases      = [ makeStair(false), makeStair(true) ];&amp;#10;    whichStairIndex = 0;&amp;#10;});&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import pandas as pd&amp;#10;import random&amp;#10;import uuid&amp;#10;&amp;#10;CSV_FILE = 'csv/stimuli.csv'&amp;#10;ORIGINAL_FOLDER = 'images/originals_needed'&amp;#10;GENERATED_FOLDER = 'images/generated'&amp;#10;RESULTS_DIR = 'evaluation_results'&amp;#10;if not os.path.exists(RESULTS_DIR):&amp;#10;    os.makedirs(RESULTS_DIR)&amp;#10;&amp;#10;CUSTOM_BINS = [0.00, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 1.00]&amp;#10;BIN_LABELS = [f&quot;{CUSTOM_BINS[i]:.2f}-{CUSTOM_BINS[i+1]:.2f}&quot; for i in range(len(CUSTOM_BINS)-1)]&amp;#10;&amp;#10;NUM_TRIALS = 190&amp;#10;NUM_REVERSAL_TRIALS = 3&amp;#10;MINIMUM_NUM_TRIALS = 6&amp;#10;STEPSIZE = 1&amp;#10;&amp;#10;df = pd.read_csv(CSV_FILE)&amp;#10;df = df.dropna(subset=['clip_similarity'])&amp;#10;df['bin'] = -1&amp;#10;for i in range(len(CUSTOM_BINS)-1):&amp;#10;    if i == len(CUSTOM_BINS)-2:&amp;#10;        mask = (df['clip_similarity'] &gt;= CUSTOM_BINS[i]) &amp; (df['clip_similarity'] &lt;= CUSTOM_BINS[i+1])&amp;#10;    else:&amp;#10;        mask = (df['clip_similarity'] &gt;= CUSTOM_BINS[i]) &amp; (df['clip_similarity'] &lt; CUSTOM_BINS[i+1])&amp;#10;    df.loc[mask, 'bin'] = i&amp;#10;all_bin_ids = sorted(df['bin'].unique())&amp;#10;all_bin_ids = [b for b in all_bin_ids if b &gt;= 0]&amp;#10;bins_to_indices = {i: df.index[df['bin'] == i].tolist() for i in range(len(CUSTOM_BINS)-1)}&amp;#10;&amp;#10;possible_values = all_bin_ids&amp;#10;init_bin = min(all_bin_ids)&amp;#10;current_index = possible_values.index(init_bin)&amp;#10;current_bin = possible_values[current_index]&amp;#10;history = []&amp;#10;responses = []&amp;#10;reaction_times = []&amp;#10;key_presses = []&amp;#10;orig_lefts = []&amp;#10;reversal_indices = []&amp;#10;prev_response = None&amp;#10;trial_idx = 0&amp;#10;is_finished = False&amp;#10;random.seed()&amp;#10;img_order_per_bin = {k: random.sample(v, len(v)) for k,v in bins_to_indices.items()}&amp;#10;used_idx_in_bin = {k: 0 for k in bins_to_indices}&amp;#10;used_global_indices = set()&amp;#10;user_age = expInfo['age']&amp;#10;user_gender = expInfo['gender']&amp;#10;user_id = str(uuid.uuid4())[:6]&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="///////////////////////&amp;#10;// &quot;Begin Routine&quot; TAB&amp;#10;///////////////////////&amp;#10;&amp;#10;// Reset resize flag&amp;#10;image1Resized = false;&amp;#10;&amp;#10;// Select the active staircase&amp;#10;var sc = staircases[whichStairIndex];&amp;#10;currentIndex = sc.currentIndex;   // for legacy code below&amp;#10;currentBin   = sc.currentBin;&amp;#10;&amp;#10;// Build list of candidate bins (staircase‐style expanding)&amp;#10;let candidateBins = [ currentBin ];&amp;#10;let max_offset    = Math.max(...possibleValues.map(b =&gt; Math.abs(b - currentBin)));&amp;#10;for (let offset = 1; offset &lt;= max_offset; offset++) {&amp;#10;  let down = currentBin - offset,&amp;#10;      up   = currentBin + offset;&amp;#10;  if (possibleValues.includes(down)) candidateBins.push(down);&amp;#10;  if (possibleValues.includes(up))   candidateBins.push(up);&amp;#10;}&amp;#10;&amp;#10;// Find a new unused image index from these bins&amp;#10;let found = false, img_idx;&amp;#10;for (let b of candidateBins) {&amp;#10;  let idxs = imgOrderPerBin[b] || [];&amp;#10;  while (usedIdxInBin[b] &lt; idxs.length) {&amp;#10;    img_idx = idxs[ usedIdxInBin[b]++ ];&amp;#10;    if (!usedGlobalIndices.has(img_idx)) {&amp;#10;      usedGlobalIndices.add(img_idx);&amp;#10;      found = true;&amp;#10;      break;&amp;#10;    }&amp;#10;  }&amp;#10;  if (found) break;&amp;#10;}&amp;#10;&amp;#10;// If no image found, mark this staircase finished&amp;#10;if (!found || img_idx === undefined || !df[img_idx]) {&amp;#10;  sc.finished = true;&amp;#10;&amp;#10;  // If both staircases are done, end the loop&amp;#10;  if (staircases.every(s =&gt; s.finished)) {&amp;#10;    trials.finished = true;&amp;#10;  }&amp;#10;  continueRoutine = false;&amp;#10;  currentRow      = null;&amp;#10;} &amp;#10;else {&amp;#10;  // Otherwise set up the trial normally&amp;#10;  currentRow = df[img_idx];&amp;#10;  shownRows.push(currentRow);&amp;#10;&amp;#10;  let origPath = ORIGINAL_FOLDER + currentRow.original_image;&amp;#10;  let genPath  = GENERATED_FOLDER  + currentRow.generated_image;&amp;#10;  let origLeft = Math.random() &lt; 0.5;&amp;#10;&amp;#10;  image1_path = origLeft ? origPath : genPath;&amp;#10;  image2_path = origLeft ? genPath  : origPath;&amp;#10;&amp;#10;  //info_str = `Bin: ${BIN_LABELS[currentRow.bin]} | Similarity: ${currentRow.clip_similarity.toFixed(3)} | Trial ${sc.trialCount+1}`;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# --- Pick next available image pair from current bin (search nearby bins if needed)&amp;#10;candidate_bins = [current_bin]&amp;#10;bin_range = possible_values&amp;#10;max_offset = max(abs(b - current_bin) for b in bin_range)&amp;#10;for offset in range(1, max_offset+1):&amp;#10;    down = current_bin - offset&amp;#10;    up = current_bin + offset&amp;#10;    if down in bin_range: candidate_bins.append(down)&amp;#10;    if up in bin_range: candidate_bins.append(up)&amp;#10;found_img = False&amp;#10;for try_bin in candidate_bins:&amp;#10;    idxs = img_order_per_bin.get(try_bin, [])&amp;#10;    while used_idx_in_bin.get(try_bin, 0) &lt; len(idxs):&amp;#10;        img_idx = idxs[used_idx_in_bin[try_bin]]&amp;#10;        used_idx_in_bin[try_bin] += 1&amp;#10;        if img_idx not in used_global_indices:&amp;#10;            found_img = True&amp;#10;            break&amp;#10;    if found_img:&amp;#10;        break&amp;#10;if not found_img:&amp;#10;    continueRoutine = False&amp;#10;    trials.finished = True&amp;#10;    is_finished = True&amp;#10;else:&amp;#10;    used_global_indices.add(img_idx)&amp;#10;    row = df.loc[img_idx]&amp;#10;    orig_path = os.path.join(ORIGINAL_FOLDER, row['original_image'])&amp;#10;    gen_path = os.path.join(GENERATED_FOLDER, row['generated_image'])&amp;#10;    orig_left = random.choice([True, False])&amp;#10;    if orig_left:&amp;#10;        image1_path = orig_path&amp;#10;        image2_path = gen_path&amp;#10;    else:&amp;#10;        image1_path = gen_path&amp;#10;        image2_path = orig_path&amp;#10;    info_str = f&quot;Bin: {BIN_LABELS[int(row['bin'])]}   |   Similarity: {row['clip_similarity']:.3f}   |   Trial {trial_idx+1}&quot;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="////////////////////&amp;#10;// &quot;Each Frame&quot; TAB&amp;#10;////////////////////&amp;#10;&amp;#10;// Helper to scale images&amp;#10;function scaleToFitBox(imgComponent, targetSize=[0.5,0.5]) {&amp;#10;  if (!imgComponent._image ||&amp;#10;      !imgComponent._image.complete ||&amp;#10;      imgComponent._image.naturalWidth === 0) {&amp;#10;    return;&amp;#10;  }&amp;#10;  let iw = imgComponent._image.naturalWidth,&amp;#10;      ih = imgComponent._image.naturalHeight,&amp;#10;      boxW = targetSize[0],&amp;#10;      boxH = targetSize[1],&amp;#10;      imageAspect = iw/ih,&amp;#10;      boxAspect   = boxW/boxH;&amp;#10;&amp;#10;  if (imageAspect &gt; boxAspect) {&amp;#10;    imgComponent.size = [ boxW, boxW/imageAspect ];&amp;#10;  } else {&amp;#10;    imgComponent.size = [ boxH*imageAspect, boxH ];&amp;#10;  }&amp;#10;}&amp;#10;&amp;#10;if (!image1Resized &amp;&amp; image1._image &amp;&amp; image2._image) {&amp;#10;  scaleToFitBox(image1, [0.5,0.5]);&amp;#10;  scaleToFitBox(image2, [0.5,0.5]);&amp;#10;  image1Resized = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="results = []&amp;#10;for i in range(trial_idx):&amp;#10;    results.append([&amp;#10;        user_age, user_gender,&amp;#10;        df.iloc[i]['original_image'],&amp;#10;        df.iloc[i]['generated_image'],&amp;#10;        df.iloc[i]['clip_similarity'],&amp;#10;        history[i] if i &lt; len(history) else '',&amp;#10;        'Similar' if responses[i] == 1 else 'Not Similar' if responses[i] == 0 else 'NoResp',&amp;#10;        reaction_times[i] if i &lt; len(reaction_times) else '',&amp;#10;        i+1,&amp;#10;        orig_lefts[i] if i &lt; len(orig_lefts) else '',&amp;#10;        key_presses[i] if i &lt; len(key_presses) else ''&amp;#10;    ])&amp;#10;results_headers = ['Age','Gender','OriginalImage','GeneratedImage','CLIPCosineSimilarity','Bin','Response','ReactionTime','Trial','OrigOnLeft','KeyPressed']&amp;#10;output_csv = os.path.join(RESULTS_DIR, f&quot;results_{user_id}.csv&quot;)&amp;#10;import pandas as pd&amp;#10;pd.DataFrame(results, columns=results_headers).to_csv(output_csv, index=False)&amp;#10;" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="///////////////////////////&amp;#10;// &quot;End Experiment&quot; TAB&amp;#10;///////////////////////////&amp;#10;&amp;#10;// Write out all trial‐wise data&amp;#10;for (let i = 0; i &lt; shownRows.length; i++) {&amp;#10;  psychoJS.experiment.addData(&quot;staircase&quot;, stairIndices[i]);&amp;#10;  psychoJS.experiment.addData(&quot;original_image&quot;,    shownRows[i].original_image);&amp;#10;  psychoJS.experiment.addData(&quot;generated_image&quot;,   shownRows[i].generated_image);&amp;#10;  psychoJS.experiment.addData(&quot;clip_similarity&quot;,   shownRows[i].clip_similarity);&amp;#10;  psychoJS.experiment.addData(&quot;response&quot;,          responses[i]);&amp;#10;  psychoJS.experiment.addData(&quot;reaction_time&quot;,     reaction_times[i]);&amp;#10;  psychoJS.experiment.addData(&quot;key_pressed&quot;,       key_presses[i]);&amp;#10;  psychoJS.experiment.addData(&quot;original_left&quot;,     orig_lefts[i]);&amp;#10;  psychoJS.experiment.nextEntry();&amp;#10;}&amp;#10;&amp;#10;// Add the questionnaire/ranking summary if present&amp;#10;if (window.rankingData) {&amp;#10;  psychoJS.experiment.addData(&quot;trial_type&quot;,    &quot;ranking_summary&quot;);&amp;#10;  psychoJS.experiment.addData(&quot;ranking_order&quot;, window.rankingData.ranking_order);&amp;#10;  psychoJS.experiment.addData(&quot;ranking_count&quot;, window.rankingData.ranking_count);&amp;#10;&amp;#10;  Object.keys(window.rankingData).forEach(key =&gt; {&amp;#10;    if (key.startsWith('factor_')) {&amp;#10;      psychoJS.experiment.addData(key, window.rankingData[key]);&amp;#10;    }&amp;#10;  });&amp;#10;  psychoJS.experiment.nextEntry();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="////////////////////&amp;#10;// &quot;End Routine&quot; TAB&amp;#10;////////////////////&amp;#10;&amp;#10;let resp = null, kp='none', rt='';&amp;#10;&amp;#10;// Gather keyboard or mouse response as before&amp;#10;if (key_resp.keys) {&amp;#10;  let kl = Array.isArray(key_resp.keys) ? key_resp.keys : [key_resp.keys];&amp;#10;  if (kl.includes('right') || kl.includes('d')) {&amp;#10;    resp = 1; kp = kl.slice(-1)[0];&amp;#10;  } else if (kl.includes('left') || kl.includes('a')) {&amp;#10;    resp = 0; kp = kl.slice(-1)[0];&amp;#10;  }&amp;#10;  rt = Array.isArray(key_resp.rt) ? (key_resp.rt.slice(-1)[0] || '') : key_resp.rt;&amp;#10;}&amp;#10;else if (mouse_resp.clicked_name) {&amp;#10;  if (mouse_resp.clicked_name.includes('btn_sim'))     { resp = 1; kp = 'mouse_sim'; }&amp;#10;  else if (mouse_resp.clicked_name.includes('btn_notsim')) { resp = 0; kp = 'mouse_notsim'; }&amp;#10;  rt = (mouse_resp.times &amp;&amp; mouse_resp.times.length)&amp;#10;       ? mouse_resp.times.slice(-1)[0]&amp;#10;       : '';&amp;#10;}&amp;#10;&amp;#10;if (currentRow) {&amp;#10;  // Log global history&amp;#10;  history.push(currentRow.bin);&amp;#10;  responses.push(resp);&amp;#10;  reaction_times.push(rt);&amp;#10;  key_presses.push(kp);&amp;#10;  orig_lefts.push(image1_path.includes(currentRow.original_image));&amp;#10;&amp;#10;  // Update the active staircase&amp;#10;  var sc = staircases[whichStairIndex];&amp;#10;  sc.trialCount++;&amp;#10;&amp;#10;  // reversal detection&amp;#10;  if (sc.prevResponse !== null &amp;&amp; sc.prevResponse !== resp) {&amp;#10;    sc.reversalIndices.push(sc.trialCount - 1);&amp;#10;  }&amp;#10;  sc.prevResponse = resp;&amp;#10;&amp;#10;  // staircase step&amp;#10;  if (resp === 0) {&amp;#10;    sc.currentIndex = Math.min(sc.currentIndex + STEPSIZE, possibleValues.length - 1);&amp;#10;  } else {&amp;#10;    sc.currentIndex = Math.max(sc.currentIndex - STEPSIZE, 0);&amp;#10;  }&amp;#10;  sc.currentBin = possibleValues[ sc.currentIndex ];&amp;#10;&amp;#10;  // finish criterion&amp;#10;  /*if (sc.reversalIndices.length &gt;= NUM_REVERSALS &amp;&amp;&amp;#10;      sc.trialCount       &gt;= MIN_TRIALS) {&amp;#10;    sc.finished = true;&amp;#10;  }*/&amp;#10;  if (sc.reversalIndices.length &gt;= NUM_REVERSALS) {&amp;#10;    sc.finished = true;&amp;#10;  }&amp;#10;&amp;#10;  // alternate staircases&amp;#10;  //whichStairIndex = 1 - whichStairIndex;&amp;#10;  // RECORD which staircase this was&amp;#10;  stairIndices.push(whichStairIndex);&amp;#10;  // now alternate to the other staircase&amp;#10;  whichStairIndex = 1 - whichStairIndex;&amp;#10;&amp;#10;  /*// if both done, end loop&amp;#10;  if (staircases.every(s =&gt; s.finished)) {&amp;#10;    trials.finished = true;&amp;#10;  }*/&amp;#10;    // now check overall stop: both staircases reversed enough AND total trials ≥ MIN_TRIALS&amp;#10;  const bothReversed = staircases.every(s =&gt; s.reversalIndices.length &gt;= NUM_REVERSALS);&amp;#10;  const totalTrials  = staircases.reduce((sum, s) =&gt; sum + s.trialCount, 0);&amp;#10;  if (bothReversed &amp;&amp; totalTrials &gt;= MIN_TRIALS) {&amp;#10;    trials.finished = true;&amp;#10;  }&amp;#10;  &amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="resp = None&amp;#10;kp = None&amp;#10;rt = None&amp;#10;# --- Check keyboard first&amp;#10;if key_resp.keys:&amp;#10;    # key_resp.keys is a list if Force end of Routine is OFF, else a string if ON&amp;#10;    # key_resp.rt is a float if Force end of Routine is ON, else a list&amp;#10;    # Handle both&amp;#10;    key_list = key_resp.keys if isinstance(key_resp.keys, list) else [key_resp.keys]&amp;#10;    if 'right' in key_list or 'd' in key_list:&amp;#10;        resp = 1&amp;#10;        kp = key_list[-1]&amp;#10;    elif 'left' in key_list or 'a' in key_list:&amp;#10;        resp = 0&amp;#10;        kp = key_list[-1]&amp;#10;    if isinstance(key_resp.rt, list):&amp;#10;        rt = key_resp.rt[-1] if key_resp.rt else ''&amp;#10;    else:&amp;#10;        rt = key_resp.rt&amp;#10;&amp;#10;# --- Mouse response&amp;#10;elif mouse_resp.clicked_name:&amp;#10;    if 'btn_sim' in mouse_resp.clicked_name:&amp;#10;        resp = 1&amp;#10;        kp = 'mouse_sim'&amp;#10;    elif 'btn_notsim' in mouse_resp.clicked_name:&amp;#10;        resp = 0&amp;#10;        kp = 'mouse_notsim'&amp;#10;    rt = mouse_resp.times[-1] if hasattr(mouse_resp, 'times') and mouse_resp.times else ''&amp;#10;else:&amp;#10;    resp = None&amp;#10;    kp = 'none'&amp;#10;    rt = ''&amp;#10;&amp;#10;# Log&amp;#10;history.append(row['bin'])&amp;#10;responses.append(resp)&amp;#10;reaction_times.append(rt)&amp;#10;key_presses.append(kp)&amp;#10;orig_lefts.append(orig_left)&amp;#10;trial_idx += 1&amp;#10;&amp;#10;# --- STAIRCASE LOGIC ---&amp;#10;if prev_response is not None and resp is not None and prev_response != resp:&amp;#10;    reversal_indices.append(trial_idx-1)&amp;#10;prev_response = resp&amp;#10;if resp == 1:&amp;#10;    current_index = min(current_index + STEPSIZE, len(possible_values)-1)&amp;#10;elif resp == 0:&amp;#10;    current_index = max(current_index - STEPSIZE, 0)&amp;#10;current_bin = possible_values[current_index]&amp;#10;&amp;#10;if len(reversal_indices) &gt;= NUM_REVERSAL_TRIALS and trial_idx &gt;= MINIMUM_NUM_TRIALS:&amp;#10;    is_finished = True&amp;#10;    trials.finished = True&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
