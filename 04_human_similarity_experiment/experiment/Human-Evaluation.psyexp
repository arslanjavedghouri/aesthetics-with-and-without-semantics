        <Param val="Consent to Participate in Research&amp;#10;&amp;#10;You are invited to take part in a research study that investigates how people perceive similarity between images. In this study, you will be shown pairs of images and asked to judge their similarity. Afterward, you will be asked to rate which visual or semantic factors influenced your decisions.&amp;#10;&amp;#10;The study will also collect basic demographic information such as your age and gender. Your responses will be stored anonymously and used only for research purposes.&amp;#10;&amp;#10;Participation is voluntary, and you may withdraw at any time without any penalty. Your data will be kept confidential and used solely for academic analysis and potential publication.&amp;#10;&amp;#10;By checking the box below and continuing, you indicate that:&amp;#10;- You are at least 18 years old&amp;#10;- You understand the nature of the study&amp;#10;- You agree to participate voluntarily&amp;#10;&amp;#10;If you do not agree, please close the browser window now." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
    <Routine name="ConsentForm">
      <RoutineSettingsComponent name="ConsentForm" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="ConsentForm" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="ConsentCode" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="window.consentGiven = false;&amp;#10;window.consentUIBuilt = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="// Set flag to block continuation until consent is given&amp;#10;window.userConsented = false;&amp;#10;continueRoutine = true;&amp;#10;&amp;#10;// Create container&amp;#10;const consentBox = document.createElement('div');&amp;#10;consentBox.id = 'consentBox';&amp;#10;consentBox.style.cssText = `&amp;#10;  position: fixed;&amp;#10;  top: 50%;&amp;#10;  left: 50%;&amp;#10;  transform: translate(-50%, -50%);&amp;#10;  width: 90%;&amp;#10;  max-width: 800px;&amp;#10;  background: #fff;&amp;#10;  border: 2px solid #333;&amp;#10;  border-radius: 10px;&amp;#10;  padding: 30px;&amp;#10;  box-shadow: 0 4px 15px rgba(0,0,0,0.2);&amp;#10;  font-family: Arial, sans-serif;&amp;#10;  z-index: 1000;&amp;#10;  overflow-y: auto;&amp;#10;  max-height: 80vh;&amp;#10;`;&amp;#10;&amp;#10;// Consent text&amp;#10;const consentText = document.createElement('p');&amp;#10;consentText.innerHTML = `&amp;#10;  &lt;strong&gt;Consent Form&lt;/strong&gt;&lt;br&gt;&lt;br&gt;&amp;#10;&amp;#10;You are invited to participate in a research study on how people perceive visual similarity between images. This study is part of an academic project investigating human aesthetic preferences and visual cognition.&lt;br&gt;&lt;br&gt;&amp;#10;&amp;#10;Participation involves viewing image pairs and making similarity judgments, followed by a short set of demographic questions (including age, gender, country of origin, and any background in photography or visual arts).&lt;br&gt;&lt;br&gt;&amp;#10;&amp;#10;Your participation is entirely voluntary, and you may withdraw at any time without penalty. No personally identifiable information (such as your name or contact details) will be collected. All responses will be stored securely and analyzed only in anonymized form.&lt;br&gt;&lt;br&gt;&amp;#10;&amp;#10;This research complies with the General Data Protection Regulation (GDPR) and institutional data privacy policies. Data will be used exclusively for academic research and not shared beyond the research team.&lt;br&gt;&lt;br&gt;&amp;#10;&amp;#10;By checking the box below, you confirm that:&amp;#10;&lt;ul&gt;&amp;#10;  &lt;li&gt;You are at least 18 years old&lt;/li&gt;&amp;#10;  &lt;li&gt;You understand the purpose and procedures of this study&lt;/li&gt;&amp;#10;  &lt;li&gt;You consent to participate voluntarily&lt;/li&gt;&amp;#10;&lt;/ul&gt;&amp;#10;&amp;#10;Thank you for your contribution to this research. Click &quot;I agree&quot; if you consent.&amp;#10;`;&amp;#10;consentText.style.cssText = `&amp;#10;  font-size: 16px;&amp;#10;  margin-bottom: 20px;&amp;#10;`;&amp;#10;&amp;#10;// Checkbox&amp;#10;const consentCheckbox = document.createElement('input');&amp;#10;consentCheckbox.type = 'checkbox';&amp;#10;consentCheckbox.id = 'consentCheckbox';&amp;#10;consentCheckbox.style.marginRight = '10px';&amp;#10;&amp;#10;const checkboxLabel = document.createElement('label');&amp;#10;checkboxLabel.textContent = 'I agree to participate in this study.';&amp;#10;checkboxLabel.htmlFor = 'consentCheckbox';&amp;#10;&amp;#10;// Continue button (initially disabled)&amp;#10;const continueBtn = document.createElement('button');&amp;#10;continueBtn.textContent = 'Continue';&amp;#10;continueBtn.disabled = true;  // ← DISABLED by default&amp;#10;continueBtn.style.cssText = `&amp;#10;  display: block;&amp;#10;  margin-top: 20px;&amp;#10;  padding: 10px 20px;&amp;#10;  background: #4CAF50;&amp;#10;  color: white;&amp;#10;  border: none;&amp;#10;  border-radius: 6px;&amp;#10;  font-size: 16px;&amp;#10;  cursor: not-allowed;&amp;#10;  opacity: 0.5;&amp;#10;`;&amp;#10;&amp;#10;// Enable button when checkbox is checked&amp;#10;consentCheckbox.addEventListener('change', function () {&amp;#10;  if (consentCheckbox.checked) {&amp;#10;    continueBtn.disabled = false;&amp;#10;    continueBtn.style.cursor = 'pointer';&amp;#10;    continueBtn.style.opacity = '1';&amp;#10;  } else {&amp;#10;    continueBtn.disabled = true;&amp;#10;    continueBtn.style.cursor = 'not-allowed';&amp;#10;    continueBtn.style.opacity = '0.5';&amp;#10;  }&amp;#10;});&amp;#10;&amp;#10;// Continue action&amp;#10;continueBtn.onclick = function () {&amp;#10;  window.userConsented = true;&amp;#10;  const el = document.getElementById('consentBox');&amp;#10;  if (el &amp;&amp; el.parentNode) el.parentNode.removeChild(el);&amp;#10;  document.body.style.overflow = 'auto';&amp;#10;};&amp;#10;&amp;#10;// Assemble UI&amp;#10;consentBox.appendChild(consentText);&amp;#10;consentBox.appendChild(consentCheckbox);&amp;#10;consentBox.appendChild(checkboxLabel);&amp;#10;consentBox.appendChild(continueBtn);&amp;#10;document.body.appendChild(consentBox);&amp;#10;document.body.style.overflow = 'hidden';&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if (!window.consentUIBuilt) {&amp;#10;    const consentContainer = document.createElement('div');&amp;#10;    consentContainer.id = 'consentContainer';&amp;#10;    consentContainer.style.cssText = `&amp;#10;        position: fixed;&amp;#10;        top: 10%;&amp;#10;        left: 50%;&amp;#10;        transform: translateX(-50%);&amp;#10;        width: 90%;&amp;#10;        max-width: 800px;&amp;#10;        background: white;&amp;#10;        border: 2px solid #555;&amp;#10;        border-radius: 10px;&amp;#10;        padding: 20px;&amp;#10;        font-family: Arial, sans-serif;&amp;#10;        z-index: 1000;&amp;#10;        box-shadow: 0 0 20px rgba(0,0,0,0.2);&amp;#10;        overflow-y: auto;&amp;#10;        max-height: 80vh;&amp;#10;    `;&amp;#10;&amp;#10;    const info = document.createElement('p');&amp;#10;    info.innerHTML = `&amp;#10;        &lt;strong&gt;Consent Form&lt;/strong&gt;&lt;br&gt;&lt;br&gt;&amp;#10;        You are invited to participate in this research study. Your responses will be anonymized and used only for academic purposes.&amp;#10;        By checking the box below, you confirm that you are at least 18 years old and you agree to participate voluntarily.&amp;#10;    `;&amp;#10;&amp;#10;    const checkboxDiv = document.createElement('div');&amp;#10;    const checkbox = document.createElement('input');&amp;#10;    checkbox.type = 'checkbox';&amp;#10;    checkbox.id = 'consentCheckbox';&amp;#10;    checkbox.style.cssText = 'margin-right: 10px; transform: scale(1.2);';&amp;#10;&amp;#10;    const label = document.createElement('label');&amp;#10;    label.htmlFor = 'consentCheckbox';&amp;#10;    label.textContent = 'I am 18 years or older and I agree to participate in the study.';&amp;#10;&amp;#10;    checkboxDiv.style.cssText = 'margin-bottom: 20px; display: flex; align-items: center;';&amp;#10;    checkboxDiv.appendChild(checkbox);&amp;#10;    checkboxDiv.appendChild(label);&amp;#10;&amp;#10;    const button = document.createElement('button');&amp;#10;    button.textContent = 'Continue';&amp;#10;    button.style.cssText = `&amp;#10;        padding: 12px 20px;&amp;#10;        background: #4CAF50;&amp;#10;        color: white;&amp;#10;        border: none;&amp;#10;        border-radius: 6px;&amp;#10;        font-size: 16px;&amp;#10;        cursor: pointer;&amp;#10;    `;&amp;#10;&amp;#10;    button.onclick = () =&gt; {&amp;#10;        if (checkbox.checked) {&amp;#10;            window.consentGiven = true;&amp;#10;            if (consentContainer?.parentNode) consentContainer.parentNode.removeChild(consentContainer);&amp;#10;            document.body.style.overflow = 'auto';&amp;#10;        } else {&amp;#10;            alert(&quot;Please agree to the consent form before continuing.&quot;);&amp;#10;        }&amp;#10;    };&amp;#10;&amp;#10;    consentContainer.appendChild(info);&amp;#10;    consentContainer.appendChild(checkboxDiv);&amp;#10;    consentContainer.appendChild(button);&amp;#10;    document.body.appendChild(consentContainer);&amp;#10;    document.body.style.overflow = 'hidden';&amp;#10;    window.consentUIBuilt = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if (window.consentGiven) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// Prevent continuation until user consents&amp;#10;if (window.userConsented) {&amp;#10;  continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="const el = document.getElementById('consentBox');&amp;#10;if (el &amp;&amp; el.parentNode) el.parentNode.removeChild(el);&amp;#10;document.body.style.overflow = 'auto';&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="const existing = document.getElementById('consentContainer');&amp;#10;if (existing?.parentNode) {&amp;#10;    existing.parentNode.removeChild(existing);&amp;#10;    document.body.style.overflow = 'auto';&amp;#10;}&amp;#10;&amp;#10;// Optional: Save consent data&amp;#10;if (typeof psychoJS !== 'undefined') {&amp;#10;    psychoJS.experiment.addData(&quot;consent_given&quot;, true);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="ConsentCode" valType="code" updates="None" name="name"/>
      </CodeComponent>
